<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.edu.upeu.mifinanzas.FinanzasController">

    <children>

        <VBox spacing="15.0"
              AnchorPane.bottomAnchor="20.0"
              AnchorPane.leftAnchor="20.0"
              AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">

            <Label text="MI FINANZAS"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Control de ingresos y gastos"
                   style="-fx-font-size: 16px;"/>

            <HBox spacing="10.0">

                <TextField fx:id="txtDescripcion"
                           promptText="Descripción"
                           prefWidth="200.0"/>

                <TextField fx:id="txtMonto"
                           promptText="Monto"
                           prefWidth="120.0"/>

                <ComboBox fx:id="cmbTipo"
                          promptText="Tipo"
                          prefWidth="130.0"/>

                <Button text="Registrar"
                        onAction="#registrarMovimiento"
                        prefWidth="110.0"/>

                <Button text="Eliminar"
                        onAction="#eliminarMovimiento"
                        prefWidth="110.0"/>

            </HBox>

            <Label text="Saldo actual:"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label fx:id="lblSaldo"
                   text="S/ 0.00"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <TableView fx:id="tablaMovimientos"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colDescripcion"
                                 text="Descripción"
                                 prefWidth="250.0"/>

                    <TableColumn fx:id="colTipo"
                                 text="Tipo"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="colMonto"
                                 text="Monto"
                                 prefWidth="150.0"/>

                </columns>

            </TableView>

        </VBox>

    </children>

</AnchorPane>